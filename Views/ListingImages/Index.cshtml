@model ListingImageManagementViewModel
@{
    ViewData["ClientResources"] = "images";
    ViewData["Title"] = Text["ListingImages.PageTitle"].Value;
    var title = string.IsNullOrWhiteSpace(Model.ListingTitle) ? Text["MyListings.Untitled"].Value : Model.ListingTitle;
    var success = TempData["ListingImageSuccess"] as string;
    var incomplete = Model.Outcome?.Status is ListingServiceStatus.CleanupPending or ListingServiceStatus.ReconciliationRequired;
}
<div class="owner-page image-manager">
    <nav class="owner-listing-actions mb-4" aria-label="@Text["MyListings.ManagementLabel"]">
        <a class="owner-back-link mb-0" asp-controller="MyListings" asp-action="Edit" asp-route-id="@Model.ListingId">@Text["ListingEditor.BackToEdit"]</a>
        <a class="btn btn-primary" asp-controller="MyListings" asp-action="Edit" asp-route-id="@Model.ListingId" asp-fragment="editor-photos">@Text["ListingEditor.OpenEditor"]</a>
        <a class="owner-back-link mb-0" asp-controller="ListingAvailability" asp-action="Index" asp-route-listingId="@Model.ListingId">@(Model.CanEdit ? Text["Availability.Manage"].Value : Text["Availability.View"].Value)</a>
    </nav>
    <header class="page-header owner-page-heading">
        <div>
            <h1>@Text["ListingImages.Heading"]</h1>
            <p class="image-listing-title">@title</p>
        </div>
        <partial name="~/Views/MyListings/_ListingStatus.cshtml" model="Model.Status" />
    </header>
    @if (Model.Outcome is null && !string.IsNullOrWhiteSpace(success))
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (incomplete)
    {
        <div class="alert alert-warning" role="alert" aria-labelledby="image-operation-heading">
            <h2 id="image-operation-heading" class="h5">@Text["ListingImages.IncompleteHeading"]</h2>
            @if (Model.Outcome!.Status == ListingServiceStatus.CleanupPending && Model.Outcome.MetadataRemoved == true)
            {
                <p>@Text["ListingImages.DeletionCleanupPending"]</p>
                <p>@Text["ListingImages.DoNotRepeatDeletion"]</p>
            }
            else if (Model.Outcome!.Status == ListingServiceStatus.CleanupPending)
            {
                <p>@Text["ListingImages.UploadCleanupPending"]</p>
            }
            else
            {
                <p>@Text["ListingImages.ReconciliationRequired"]</p>
            }
            <div asp-validation-summary="All"></div>
        </div>
    }
    else if (!ViewData.ModelState.IsValid || Model.Outcome is not null)
    {
        <div class="alert alert-danger" role="alert" aria-labelledby="image-error-heading">
            <h2 id="image-error-heading" class="h5">@Text["ListingImages.ActionFailed"]</h2>
            <p>@Text["ListingImages.FailureHelp"]</p>
            <div asp-validation-summary="All"></div>
        </div>
    }
    @if (!Model.CanEdit)
    {
        <div class="alert alert-info">@Text["ListingImages.ArchivedHelp"]</div>
    }
    <div class="image-management-layout">
        <aside class="image-upload-panel" aria-labelledby="upload-heading">
            <div>
                <div>
                    <h2 id="upload-heading" class="h4">@(Model.CanEdit ? Text["ListingImages.AddImage"].Value : Text["ListingImages.Photos"].Value)</h2>
                    @if (Model.CanEdit)
                    {
                        <form asp-action="Upload" asp-route-listingId="@Model.ListingId" method="post" enctype="multipart/form-data" data-image-upload>
                            <div class="mb-3">
                                <label asp-for="File" class="form-label">@Text["ListingImages.ChooseImage"]</label>
                                <input asp-for="File" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" class="form-control" aria-describedby="upload-help file-error" required data-image-file />
                                <div id="upload-help" class="form-text">@Text["ListingImages.SizeHelp", Model.MaxImageSizeLabel]</div>
                                <span asp-validation-for="File" id="file-error"></span>
                            </div>
                            <figure class="image-upload-preview" data-upload-preview hidden>
                                <img alt="@Text["ListingImages.SelectedUploadPreview"]" data-upload-preview-image />
                                <figcaption class="form-text" data-upload-preview-caption></figcaption>
                            </figure>
                            <p class="form-text" role="status" aria-live="polite" data-upload-preview-status></p>
                            <div class="mb-3">
                                <label asp-for="AltText" class="form-label">@Text["ListingImages.Description"] <span class="text-muted">@Text["Common.Optional"]</span></label>
                                <input asp-for="AltText" maxlength="250" class="form-control" aria-describedby="alt-help alt-error" placeholder="@Text["ListingImages.AltPlaceholder"]" />
                                <div id="alt-help" class="form-text">@Text["ListingImages.DescriptionHelp"]</div>
                                <span asp-validation-for="AltText" id="alt-error"></span>
                            </div>
                            <button type="submit" class="btn btn-primary w-100" data-upload-submit>@Text["ListingImages.UploadImage"]</button>

                        </form>
                    }
                </div>
            </div>
        </aside>
        <section class="image-collection" aria-labelledby="images-heading">
            <div class="owner-section-heading">
                <h2 id="images-heading" class="h4">@Text["ListingImages.YourImages"] <span class="owner-listing-count">@Text["Common.CountInParentheses", Model.Images.Count]</span></h2>
                <p class="text-muted">@Text["ListingImages.SavedOrderHelp"]</p>
            </div>
            @Html.ValidationMessage("ImageIds")
            @Html.ValidationMessage("Images")
            @if (Model.Images.Count == 0)
            {
                <div class="empty-state">
                    <h3 class="h5">@(Model.CanEdit ? Text["ListingImages.FirstPhoto"].Value : Text["ListingImages.NoImages"].Value)</h3>
                    <p>@(Model.CanEdit ? Text["ListingImages.FirstPhotoHelp"].Value : Text["ListingImages.ArchivedEmpty"].Value)</p>
                </div>
            }
            else
            {
                @if (!Model.CanDeleteImages && Model.CanEdit)
                {
                    <div class="alert alert-info">@Text["ListingImages.RequiredImageHelp"]</div>
                }
                <div class="managed-image-grid">
                    @for (var index = 0; index < Model.Images.Count; index++)
                    {
                        var photo = Model.Images[index];
                        var image = photo.Image;
                        var imageUrl = Url.Action("Get", "ListingImageContent", new { listingId = Model.ListingId, imageId = image.ListingImageId });
                        var photoNumber = index + 1;
                        <article class="card managed-image-card" aria-labelledby="image-heading-@image.ListingImageId">
                            <partial name="_ListingGallery" model="@(new ListingGalleryViewModel(title, new[] { new ListingGalleryPhotoViewModel(imageUrl!, image.AltText, image.IsPrimary) }))" />
                            <div class="card-body managed-image-body">
                                <div class="owner-listing-title-row">
                                    <h3 id="image-heading-@image.ListingImageId" class="h5">@Text["ListingImages.ImageNumber", photoNumber]</h3>
                                    @if (image.IsPrimary)
                                    {
                                        <span class="badge-soft">@Text["ListingImages.PrimaryImage"]</span>
                                    }
                                </div>
                                <p class="managed-image-name">@photo.OriginalFileName</p>
                                <p class="listing-card-meta">@Text["ListingImages.SizeKiB", photo.SizeBytes / 1024m] <span aria-hidden="true">·</span> @image.ContentType</p>
                                @if (!string.IsNullOrWhiteSpace(image.AltText))
                                {
                                    <p class="managed-image-description">@image.AltText</p>
                                }
                                @if (Model.CanEdit)
                                {
                                    @if (!image.IsPrimary)
                                    {
                                        <form asp-action="SetPrimary" asp-route-listingId="@Model.ListingId" asp-route-imageId="@image.ListingImageId" method="post">
                                            <button type="submit" class="btn btn-outline-primary w-100">@Text["ListingImages.SetPrimary"]<span class="visually-hidden">@Text["ListingImages.ImageReference", photoNumber]</span></button>
                                        </form>
                                    }
                                    <div class="image-order-controls" role="group" aria-label="@Text["ListingImages.OrderLabel", photoNumber]">
                                        @foreach (var offset in new[] { -1, 1 })
                                        {
                                            var label = offset == -1 ? Text["Common.MoveUp"].Value : Text["Common.MoveDown"].Value;
                                            @if (index + offset >= 0 && index + offset < Model.Images.Count)
                                            {
                                                <form asp-action="SetDisplayOrder" asp-route-listingId="@Model.ListingId" method="post">
                                                    @foreach (var imageId in Model.GetOrderAfterMove(index, offset))
                                                    {
                                                        <input type="hidden" name="ImageIds" value="@imageId" />
                                                    }
                                                    <button type="submit" class="btn btn-outline-primary w-100">@label<span class="visually-hidden">@Text["ListingImages.ImageReference", photoNumber]</span></button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-outline-primary" disabled>@label<span class="visually-hidden">@Text["ListingImages.ImageReference", photoNumber]</span></button>
                                            }
                                        }
                                    </div>
                                    @if (Model.CanDeleteImages)
                                    {
                                        <details class="owner-archive image-delete-confirmation">
                                            <summary class="btn btn-outline-danger">@Text["ListingImages.DeleteImage"]<span class="visually-hidden"> @photoNumber</span></summary>
                                            <div class="owner-archive-confirmation">
                                                <p>@Text["ListingImages.DeletePrompt", photoNumber]</p>
                                                <form asp-action="Delete" asp-route-listingId="@Model.ListingId" asp-route-imageId="@image.ListingImageId" method="post">
                                                    <button type="submit" class="btn btn-outline-danger">@Text["Common.ConfirmDelete"]<span class="visually-hidden">@Text["ListingImages.ImageReference", photoNumber]</span></button>
                                                </form>
                                            </div>
                                        </details>
                                    }
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/owner-listings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listing-image-management.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/listing-images.js" asp-append-version="true"></script>
    <script src="~/js/listing-image-management.js" asp-append-version="true"></script>
}

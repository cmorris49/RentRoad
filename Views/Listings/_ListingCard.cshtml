@using RentRoad.ViewModels.Listings
@model ListingSummaryViewModel
@{
    var title = string.IsNullOrWhiteSpace(Model.Title) ? Text["Listing.Untitled"].Value : Model.Title;
}
<article class="listing-card listing-card-link">
    @{
        var photos = Model.GalleryPhotos.Count > 0 ? Model.GalleryPhotos : Model.CoverImage is null
            ? Array.Empty<ListingGalleryPhotoViewModel>()
            : new[] { new ListingGalleryPhotoViewModel(Url.Action("Get", "ListingImageContent", new { listingId = Model.ListingId, imageId = Model.CoverImage.ListingImageId })!, Model.CoverImage.AltText, Model.CoverImage.IsPrimary) };
    }
    <partial name="_ListingGallery" model="@(new ListingGalleryViewModel(title, photos, true, Url.Action("Details", "Listings", new { id = Model.ListingId })))" />
    <div class="card-body listing-card-body">
        <span class="listing-card-category">@ListingDisplayText.Category(Model.Category)</span>
        <h3 class="listing-card-title"><a class="stretched-link" asp-controller="Listings" asp-action="Details" asp-route-id="@Model.ListingId">@title</a></h3>
        <p class="listing-card-meta">@ListingDisplayText.Condition(Model.Condition) <span aria-hidden="true">·</span> @(string.IsNullOrWhiteSpace(Model.PickupArea) ? Text["Listing.NoPickupArea"].Value : Model.PickupArea)</p>
        <div class="listing-card-bottom">
            <p><span class="listing-card-price">@Model.DailyPrice.FormattedAmount</span> <span class="listing-card-meta">@Text["Listing.PerDay"]</span></p>
            <span class="listing-card-arrow" aria-hidden="true">↗</span>
        </div>
    </div>
</article>

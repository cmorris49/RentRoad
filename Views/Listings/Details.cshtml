@using Microsoft.AspNetCore.Identity
@using RentRoad.ViewModels.Listings
@inject SignInManager<ApplicationUser> SignInManager
@model ListingDetailsViewModel
@{
    var title = string.IsNullOrWhiteSpace(Model.Title) ? Text["Listing.Untitled"].Value : Model.Title;
    var photos = Model.GalleryImages;
    ViewData["Title"] = title;
}

<div class="details-page">
    <nav class="details-breadcrumb" aria-label="@Text["Common.Breadcrumb"]">
        <a asp-controller="Listings" asp-action="Index"><span aria-hidden="true">←</span> @Text["Navigation.BrowseListings"]</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">@title</span>
    </nav>

    <div class="details-layout">
        <section class="listing-gallery" aria-label="@Text["ListingImages.Photos"]">
            <partial name="_ListingGallery" model="@(new ListingGalleryViewModel(title, photos.Select(photo => new ListingGalleryPhotoViewModel(Url.Action("Get", "ListingImageContent", new { listingId = Model.ListingId, imageId = photo.ListingImageId })!, photo.AltText, photo.IsPrimary)).ToArray()))" />
        </section>

        <section class="listing-overview" aria-labelledby="listing-title">
            <p class="eyebrow">@ListingDisplayText.Category(Model.Category)</p>
            <h1 id="listing-title">@title</h1>
            <p class="details-location">@(string.IsNullOrWhiteSpace(Model.PickupArea) ? Text["Listing.NoPickupArea"].Value : Model.PickupArea)</p>
            <dl class="listing-facts">
                <div><dt>@Text["ListingDetails.Condition"]</dt><dd>@ListingDisplayText.Condition(Model.Condition)</dd></div>
                <div><dt>@Text["ListingDetails.Owner"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.OwnerDisplayName) ? Text["ListingDetails.OwnerFallback"].Value : Model.OwnerDisplayName)</dd></div>
            </dl>

            <section class="card rental-summary" aria-labelledby="request-heading">
                <p class="rental-price"><span>@Model.DailyPrice.FormattedAmount</span> <span class="rental-price-unit">@Text["Listing.PerDay"]</span></p>
                <p class="rental-currency">@Text["ListingDetails.CadPriceHelp"]</p>
                <div class="request-heading"><h2 id="request-heading" class="h5">@Text["ListingDetails.RequestToRent"]</h2><span class="badge-soft">@Text["Common.ComingSoon"]</span></div>
                @if (SignInManager.IsSignedIn(User))
                {
                    <button class="btn btn-primary" type="button" disabled aria-describedby="request-note">@Text["ListingDetails.RequestToRent"]</button>
                    <p id="request-note" class="request-note">@Text["ListingDetails.RequestComingSoon"]</p>
                }
                else
                {
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Listings", new { id = Model.ListingId })" aria-describedby="request-note">@Text["ListingDetails.LogInToRequest"]</a>
                    <p id="request-note" class="request-note">@Text["ListingDetails.AnonymousRequestHelp"]</p>
                }
            </section>
        </section>
    </div>

    <section class="details-section description-section" aria-labelledby="description-heading">
        <p class="eyebrow">@Text["ListingDetails.Eyebrow"]</p>
        <h2 id="description-heading">@Text["ListingDetails.Description"]</h2>
        <p class="listing-description">@(string.IsNullOrWhiteSpace(Model.Description) ? Text["ListingDetails.NoDescription"].Value : Model.Description)</p>
    </section>

    <section class="details-section" aria-labelledby="availability-heading">
        <div class="availability-heading">
            <div><p class="eyebrow">@Text["Availability.PlanAhead"]</p><h2 id="availability-heading">@Text["Availability.Heading"]</h2></div>
            <p>@Text["Availability.PublicHelp"]</p>
        </div>
        <p class="date-convention">@Text["Availability.DisplayInclusiveHelp"]</p>
        <div class="availability-columns">
            <section class="card availability-panel" aria-labelledby="windows-heading">
                <h3 id="windows-heading" class="h5"><span class="availability-marker" aria-hidden="true"></span>@Text["Availability.ListedWindows"]</h3>
                @if (Model.AvailabilityWindows.Count == 0)
                {
                    <p class="availability-empty">@Text["Availability.NoListedWindows"]</p>
                }
                else
                {
                    <ul class="availability-periods">
                        @foreach (var window in Model.AvailabilityWindows)
                        {
                            <li><span class="availability-range">@window.DisplayRange</span></li>
                        }
                    </ul>
                }
            </section>
            <section class="card availability-panel blocked-periods" aria-labelledby="blocks-heading">
                <h3 id="blocks-heading" class="h5"><span class="availability-marker" aria-hidden="true"></span>@Text["Availability.BlockedUnavailableDates"]</h3>
                @if (Model.AvailabilityBlocks.Count == 0)
                {
                    <p class="availability-empty">@Text["Availability.NoListedBlocks"]</p>
                }
                else
                {
                    <ul class="availability-periods">
                        @foreach (var block in Model.AvailabilityBlocks)
                        {
                            <li><span class="availability-range">@block.DisplayRange</span></li>
                        }
                    </ul>
                }
            </section>
        </div>
    </section>
    <partial name="_ListingScroller" model='@(new ListingScrollerViewModel("similar-listings", Text["Listing.SimilarListings"].Value, Model.SimilarListings))' />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/listing-scroller.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/listing-scroller.js" asp-append-version="true" defer></script>
    <script src="~/js/listing-images.js" asp-append-version="true" defer></script>
}

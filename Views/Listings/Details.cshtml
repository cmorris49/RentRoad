@using Microsoft.AspNetCore.Identity
@using RentRoad.ViewModels.Listings
@inject SignInManager<ApplicationUser> SignInManager
@model ListingDetailsViewModel
@{
    var title = string.IsNullOrWhiteSpace(Model.Title) ? Text["Listing.Untitled"].Value : Model.Title;
    var photos = Model.GalleryImages;
    var requestFeedback = TempData["RentalRequestFeedback"] as string;
    var feedbackListingId = TempData["RentalRequestFeedbackListingId"] as int?;
    ViewData["Title"] = title;
}

<div class="details-page">
    <nav class="details-breadcrumb" aria-label="@Text["Common.Breadcrumb"]">
        @if (Model.ReturnConversationId is int returnConversationId)
        {
            <a asp-controller="Messages" asp-action="Conversation" asp-route-conversationId="@returnConversationId"><span aria-hidden="true">←</span> @Text["Conversations.BackToConversation"]</a>
        }
        else
        {
            <a asp-controller="Listings" asp-action="Index"><span aria-hidden="true">←</span> @Text["Navigation.BrowseListings"]</a>
        }
        <span aria-hidden="true">/</span>
        <span aria-current="page">@title</span>
    </nav>

    @if (requestFeedback is string feedback && feedbackListingId == Model.ListingId)
    {
        <div class="alert alert-success" role="status" data-rental-feedback>@feedback</div>
    }

    <div class="details-layout">
        <section class="listing-gallery" aria-label="@Text["ListingImages.Photos"]">
            <partial name="_ListingGallery" model="@(new ListingGalleryViewModel(title, photos.Select(photo => new ListingGalleryPhotoViewModel(Url.Action("Get", "ListingImageContent", new { listingId = Model.ListingId, imageId = photo.ListingImageId })!, photo.AltText, photo.IsPrimary)).ToArray()))" />
        </section>

        <section class="listing-overview" aria-labelledby="listing-title">
            <p class="eyebrow">@ListingDisplayText.Category(Model.Category)</p>
            <h1 id="listing-title">@title</h1>
            <p class="details-location">@(string.IsNullOrWhiteSpace(Model.PickupArea) ? Text["Listing.NoPickupArea"].Value : Model.PickupArea)</p>
            <dl class="listing-facts">
                <div><dt>@Text["ListingDetails.Condition"]</dt><dd>@ListingDisplayText.Condition(Model.Condition)</dd></div>
                <div><dt>@Text["ListingDetails.Owner"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.OwnerDisplayName) ? Text["ListingDetails.OwnerFallback"].Value : Model.OwnerDisplayName)</dd></div>
            </dl>

            <section class="card rental-summary" aria-labelledby="request-heading">
                <p class="rental-price"><span>@Model.DailyPrice.FormattedAmount</span> <span class="rental-price-unit">@Text["Listing.PerDay"]</span></p>
                <p class="rental-currency">@Text["ListingDetails.CadPriceHelp"]</p>
                <div class="request-heading"><h2 id="request-heading" class="h5">@Text["ListingDetails.RequestToRent"]</h2></div>
                @if (Model.IsOwnedByViewer)
                {
                    <button class="btn btn-primary" type="button" disabled aria-describedby="request-note">@Text["ListingDetails.RequestToRent"]</button>
                    <p id="request-note" class="request-note">@Text["RentalRequestUi.OwnListing"]</p>
                }
                else if (SignInManager.IsSignedIn(User))
                {
                    <a class="btn btn-primary" asp-controller="RentalRequests" asp-action="Create" asp-route-listingId="@Model.ListingId" aria-describedby="request-note">@Text["ListingDetails.RequestToRent"]</a>
                    <p id="request-note" class="request-note">@Text["RentalRequestUi.PendingHelp"]</p>
                }
                else
                {
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Create", "RentalRequests", new { listingId = Model.ListingId })" aria-describedby="request-note">@Text["ListingDetails.LogInToRequest"]</a>
                    <p id="request-note" class="request-note">@Text["RentalRequestUi.LoginHelp"]</p>
                }
                @if (!Model.IsOwnedByViewer)
                {
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <partial name="_MessageOwner" model="@(new RentRoad.ViewModels.Messaging.ConversationStartInputViewModel { ListingId = Model.ListingId })" />
                    }
                    else
                    {
                        <a class="btn btn-outline-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Listings", new { id = Model.ListingId })">@Text["Conversations.LoginToMessage"]</a>
                    }
                }
            </section>
        </section>
    </div>

    <section class="details-section description-section" aria-labelledby="description-heading">
        <p class="eyebrow">@Text["ListingDetails.Eyebrow"]</p>
        <h2 id="description-heading">@Text["ListingDetails.Description"]</h2>
        <p class="listing-description">@(string.IsNullOrWhiteSpace(Model.Description) ? Text["ListingDetails.NoDescription"].Value : Model.Description)</p>
    </section>

    <partial name="_PublicListingAvailability" model="@(new PublicListingAvailabilityViewModel(Model.AvailabilityWindows, Model.AvailabilityBlocks))" />
    <partial name="_ListingScroller" model='@(new ListingScrollerViewModel("similar-listings", Text["Listing.SimilarListings"].Value, Model.SimilarListings))' />

    <section class="details-section listing-reviews" aria-labelledby="reviews-heading">
        <p class="eyebrow">@Text["ListingDetails.Reviews"]</p>
        <h2 id="reviews-heading">@Text["ListingDetails.Reviews"]</h2>
        @if (Model.AverageRating is double averageRating)
        {
            <p class="listing-reviews-summary" aria-label="@Text["ListingDetails.ReviewSummary", averageRating, Model.Reviews.Count]">
                <span aria-hidden="true">★★★★★</span>
                @Text["ListingDetails.ReviewSummary", averageRating, Model.Reviews.Count]
            </p>
            <div class="listing-reviews-list">
                @foreach (var review in Model.Reviews)
                {
                    <article class="listing-review">
                        <div class="listing-review-heading">
                            <h3>@Text["ListingDetails.Reviewer", review.ReviewerDisplayName]</h3>
                            <time datetime="@review.CreatedAtUtc.ToString("O")">@review.CreatedAtUtc.ToLocalTime().ToString("d")</time>
                        </div>
                        <p class="listing-review-rating" aria-label="@Text["ListingDetails.Rating", review.Rating]">@(new string('★', review.Rating))</p>
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p>@review.Comment</p>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <p class="listing-reviews-empty">@Text["ListingDetails.NoReviews"]</p>
        }
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/public-listing-availability.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listing-scroller.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listing-reviews.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/listing-scroller.js" asp-append-version="true" defer></script>
    <script src="~/js/listing-images.js" asp-append-version="true" defer></script>
}

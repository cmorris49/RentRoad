@model ListingAvailabilityFormViewModel
<details class="owner-archive availability-remove">
    <summary class="btn btn-outline-danger">@Text[Model.IsBlock ? "Availability.RemoveBlock" : "Availability.RemoveWindow"]<span class="visually-hidden"> @Model.RecordId</span></summary>
    <div class="owner-archive-confirmation">
        <p>@(Model.IsBlock ? Text["Availability.RemoveBlockHelp"].Value : Text["Availability.RemoveWindowHelp"].Value)</p>
        <form asp-action="@(Model.IsBlock ? "RemoveBlock" : "RemoveWindow")" asp-route-listingId="@Model.ListingId" asp-route-windowId="@(Model.IsBlock ? null : Model.RecordId)" asp-route-blockId="@(Model.IsBlock ? Model.RecordId : null)" method="post">
            <button type="submit" class="btn btn-outline-danger">@Text["Common.ConfirmRemoval"]<span class="visually-hidden">@Text[Model.IsBlock ? "Availability.BlockRecordReference" : "Availability.WindowRecordReference", Model.RecordId!]</span></button>
        </form>
        <p class="form-text">@Text[Model.IsBlock ? "Availability.CancelRemoveBlock" : "Availability.CancelRemoveWindow"]</p>
    </div>
</details>

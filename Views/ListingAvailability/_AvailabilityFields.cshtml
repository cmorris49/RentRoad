@model ListingAvailabilityFormViewModel
<div class="availability-date-fields">
    <div>
        <label asp-for="StartDate" for="@Model.FormId-start" class="form-label">@(Model.IsBlock ? "First blocked day" : "First available day")</label>
        <input asp-for="StartDate" asp-format="{0:yyyy-MM-dd}" type="date" id="@Model.FormId-start" class="form-control" aria-describedby="@Model.FormId-date-help @Model.FormId-start-error" required />
        <span asp-validation-for="StartDate" id="@Model.FormId-start-error"></span>
    </div>
    <div>
        <label asp-for="EndDate" for="@Model.FormId-end" class="form-label">End date (not included)</label>
        <input asp-for="EndDate" asp-format="{0:yyyy-MM-dd}" type="date" id="@Model.FormId-end" class="form-control" aria-describedby="@Model.FormId-date-help @Model.FormId-end-error" required />
        <span asp-validation-for="EndDate" id="@Model.FormId-end-error"></span>
    </div>
</div>
<p id="@Model.FormId-date-help" class="form-text">@(Model.IsBlock ? "Blocked dates include the first day and stop before the end date." : "Available dates include the first day and stop before the end date.") The end must be later than the start.</p>
@if (Model.IsBlock)
{
    <div class="mb-3">
        <label asp-for="Reason" for="@Model.FormId-reason" class="form-label">Reason <span class="text-muted">(optional, private)</span></label>
        <textarea asp-for="Reason" id="@Model.FormId-reason" class="form-control" rows="2" maxlength="250" aria-describedby="@Model.FormId-reason-help @Model.FormId-reason-error"></textarea>
        <div id="@Model.FormId-reason-help" class="form-text">Only you can see this note. Up to 250 characters.</div>
        <span asp-validation-for="Reason" id="@Model.FormId-reason-error"></span>
    </div>
}

@model ListingAvailabilityFormViewModel
@inject IModelMetadataProvider MetadataProvider
@{
    var fieldsData = new ViewDataDictionary<ListingAvailabilityFormViewModel>(MetadataProvider,
        Model.IsSubmitted ? ViewData.ModelState : new ModelStateDictionary()) { Model = Model };
}
<form id="@Model.FormId-form" asp-action="@Model.ActionName" asp-route-listingId="@Model.ListingId" asp-route-windowId="@(Model.IsBlock ? null : Model.RecordId)" asp-route-blockId="@(Model.IsBlock ? Model.RecordId : null)" method="post">
    <partial name="_AvailabilityFields" model="Model" view-data="fieldsData" />
    <button type="submit" class="btn btn-primary">@(Model.RecordId.HasValue ? Text["Availability.SaveDates"].Value : Model.IsBlock ? Text["Availability.BlockDates"].Value : Text["Availability.AddWindow"].Value)<span class="visually-hidden">@Text[Model.IsBlock ? "Availability.BlockFormReference" : "Availability.WindowFormReference", Model.RecordId?.ToString() ?? string.Empty]</span></button>
</form>

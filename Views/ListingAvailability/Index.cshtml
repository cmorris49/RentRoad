@model ListingAvailabilityManagementViewModel
@{
    ViewData["Title"] = Text["Availability.PageTitle"].Value;
    var title = string.IsNullOrWhiteSpace(Model.ListingTitle) ? Text["MyListings.Untitled"].Value : Model.ListingTitle;
    var success = TempData["ListingAvailabilitySuccess"] as string;
}
<div class="owner-page availability-manager">
    <nav class="availability-navigation" aria-label="@Text["MyListings.ManagementLabel"]">
        <a class="owner-back-link" asp-controller="MyListings" asp-action="Edit" asp-route-id="@Model.ListingId">@Text["ListingEditor.BackToEdit"]</a>
        <a class="btn btn-outline-primary" asp-controller="ListingImages" asp-action="Index" asp-route-listingId="@Model.ListingId">@(Model.CanEdit ? Text["ListingImages.Manage"].Value : Text["ListingImages.View"].Value)</a>
    </nav>
    <header class="page-header owner-page-heading">
        <div>
            <p class="eyebrow">@Text["Availability.Eyebrow"]</p>
            <h1>@Text["Availability.ListingHeading"]</h1>
            <p class="availability-listing-title">@title</p>
        </div>
        <partial name="~/Views/MyListings/_ListingStatus.cshtml" model="Model.Status" />
    </header>
    @if (Model.Feedback is null && !string.IsNullOrWhiteSpace(success))
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (!ViewData.ModelState.IsValid || Model.Feedback is not null)
    {
        <div class="alert @(Model.Feedback?.Status == ListingServiceStatus.Conflict ? "alert-warning" : "alert-danger")" role="alert" aria-labelledby="availability-error-heading">
            <h2 id="availability-error-heading" class="h5">@Text["Availability.ChangeFailed"]</h2>
            <p>@Text["Availability.FailureHelp"]</p>
            <div asp-validation-summary="All"></div>
        </div>
    }
    @if (!Model.CanEdit)
    {
        <div class="alert alert-info">@Text["Availability.ArchivedHelp"]</div>
    }
    <p class="text-muted">@Text["Availability.ManagementHelp"]</p>
    <div class="availability-sections">
        <section aria-labelledby="windows-heading">
            <div class="owner-section-heading">
                <h2 id="windows-heading" class="h3">@Text["Availability.AvailableToRent"] <span class="owner-listing-count">@Text["Common.CountInParentheses", Model.AvailabilityWindows.Count]</span></h2>
            </div>
            @if (Model.CanEdit)
            {
                <div class="card availability-add-card">
                    <div class="card-body">
                        <h3 class="h5">@Text["Availability.AddWindowHeading"]</h3>
                        <partial name="_AvailabilityForm" model="Model.WindowForm()" />
                    </div>
                </div>
            }
            @if (Model.AvailabilityWindows.Count == 0)
            {
                <div class="empty-state">
                    <h3 class="h5">@Text["Availability.NoWindows"]</h3>
                    <p>@(Model.CanEdit ? Text["Availability.EmptyWindowsHelp"].Value : Text["Availability.ArchivedEmpty"].Value)</p>
                </div>
            }
            <div class="availability-periods">
                @foreach (var window in Model.AvailabilityWindows)
                {
                    var form = Model.WindowForm(window);
                    <article class="card availability-period" id="availability-window-@window.WindowId" aria-labelledby="window-heading-@window.WindowId">
                        <div class="card-body">
                            <p class="eyebrow">@Text["Availability.AvailableDates"]</p>
                            <h3 id="window-heading-@window.WindowId" class="h5">@window.Period.DisplayRange</h3>
                            @if (Model.CanEdit)
                            {
                                <details class="availability-edit" open="@form.IsSubmitted">
                                    <summary>@Text["Availability.EditWindow"]<span class="visually-hidden"> @window.WindowId</span></summary>
                                    <partial name="_AvailabilityForm" model="form" />
                                </details>
                                <partial name="_RemoveAvailability" model="form" />
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
        <section aria-labelledby="blocks-heading">
            <div class="owner-section-heading">
                <h2 id="blocks-heading" class="h3">@Text["Availability.UnavailableDates"] <span class="owner-listing-count">@Text["Common.CountInParentheses", Model.AvailabilityBlocks.Count]</span></h2>
            </div>
            <p class="text-muted">@Text["Availability.BlockHelp"]</p>
            @if (Model.CanEdit)
            {
                <div class="card availability-add-card">
                    <div class="card-body">
                        <h3 class="h5">@Text["Availability.AddBlock"]</h3>
                        <partial name="_AvailabilityForm" model="Model.BlockForm()" />
                    </div>
                </div>
            }
            @if (Model.AvailabilityBlocks.Count == 0)
            {
                <div class="empty-state">
                    <h3 class="h5">@Text["Availability.NoBlocks"]</h3>
                    <p>@Text["Availability.NoBlocksHelp"]</p>
                </div>
            }
            <div class="availability-periods">
                @foreach (var block in Model.AvailabilityBlocks)
                {
                    var form = Model.BlockForm(block);
                    <article class="card availability-period" id="availability-block-@block.BlockId" aria-labelledby="block-heading-@block.BlockId">
                        <div class="card-body">
                            <p class="eyebrow">@Text["Availability.BlockedDates"]</p>
                            <h3 id="block-heading-@block.BlockId" class="h5">@block.Period.DisplayRange</h3>
                            @if (!string.IsNullOrWhiteSpace(block.Reason))
                            {
                                <p class="availability-reason"><span class="text-muted">@Text["Availability.PrivateReason"]</span> @block.Reason</p>
                            }
                            @if (Model.CanEdit)
                            {
                                <details class="availability-edit" open="@form.IsSubmitted">
                                    <summary>@Text["Availability.EditBlock"]<span class="visually-hidden"> @block.BlockId</span></summary>
                                    @await Html.PartialAsync("_AvailabilityForm", form)
                                </details>
                                @await Html.PartialAsync("_RemoveAvailability", form)
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/owner-listings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listing-availability.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model int
<details class="owner-archive">
    <summary class="btn btn-outline-danger">@Text["MyListings.Archive"]</summary>
    <div class="owner-archive-confirmation">
        <p><strong>@Text["MyListings.ArchivePrompt"]</strong> @Text["MyListings.ArchiveConsequences"]</p>
        <form asp-controller="MyListings" asp-action="Archive" asp-route-id="@Model" method="post">
            <button type="submit" class="btn btn-outline-danger">@Text["MyListings.ConfirmArchive"]</button>
        </form>
        <p class="form-text mb-0">@Text["MyListings.CancelArchive"]</p>
    </div>
</details>

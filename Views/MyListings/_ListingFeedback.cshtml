@if (TempData["ListingSuccess"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert" aria-labelledby="listing-errors-heading">
        <h2 id="listing-errors-heading" class="h5">@Text["Common.ActionFailed"]</h2>
        <p>@Text["ListingEditor.ValidationHelp"]</p>
        <div asp-validation-summary="All"></div>
    </div>
}

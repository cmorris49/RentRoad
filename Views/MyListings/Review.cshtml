@model ListingEditorReviewViewModel
@{ ViewData["Title"] = Text["MyListings.ReviewListing"].Value; }
<div class="listing-editor">
    <a class="owner-back-link" asp-controller="MyListings" asp-action="Edit" asp-route-id="@Model.State.ListingId">@Text["ListingEditor.KeepEditingArrow"]</a>
    <h1>@Text["ListingEditor.ReviewHeading"]</h1>
    <p>@Text["ListingEditor.ConfirmHelp"]</p>
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-warning" role="alert"><h2 class="h5">@Text["ListingEditor.PublicationRequirements"]</h2><ul>@foreach (var error in Model.Errors) { <li>@error.Message</li> }</ul></div>
    }
    <h2>@Model.State.Fields.Title</h2><p>@Model.State.Fields.Description</p>
    <dl><dt>@Text["ListingEditor.CategoryCondition"]</dt><dd>@Model.State.Fields.CategoryLabel / @Model.State.Fields.ConditionLabel</dd><dt>@Text["Browse.DailyPrice"]</dt><dd>@Model.State.Fields.DailyPriceCad</dd><dt>@Text["Browse.PickupArea"]</dt><dd>@Model.State.Fields.PickupArea</dd><dt>@Text["ListingDetails.Owner"]</dt><dd>@Model.State.OwnerDisplayName</dd></dl>
    <partial name="_ListingGallery" model="@(new ListingGalleryViewModel(Model.State.Fields.Title ?? Text["ListingEditor.ListingFallback"].Value, Model.State.Images.OrderByDescending(photo => photo.IsPrimary).ThenBy(photo => photo.DisplayOrder).ThenBy(photo => photo.Id).Select(photo => new ListingGalleryPhotoViewModel(photo.Url, photo.AltText, photo.IsPrimary)).ToArray()))" />
    <h3 class="h5">@Text["Availability.Heading"]</h3><ul>@foreach (var window in Model.State.Windows) { <li>@window.DisplayRange</li> }</ul>
    <h3 class="h5">@Text["Availability.BlockedDates"]</h3><ul>@foreach (var block in Model.State.Blocks) { <li>@block.DisplayRange</li> }</ul>
    @if (Model.Nonce is not null)
    {
        <form asp-controller="ListingEditor" asp-action="Confirm" asp-route-token="@Model.State.Token" method="post"><input type="hidden" name="nonce" value="@Model.Nonce" /><button class="btn btn-primary" type="submit">@Text["ListingEditor.ConfirmPublish"]</button></form>
    }
</div>
@section Styles { <link rel="stylesheet" href="~/css/listing-editor.css" asp-append-version="true" /> }

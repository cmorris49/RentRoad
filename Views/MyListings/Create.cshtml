@model ListingCreateViewModel
@{
    ViewData["Title"] = "Create a listing";
    ViewData["EditorListingId"] = 0;
    ViewData["EditorStatus"] = ListingStatus.Draft;
}
<partial name="_ListingEditor" model="Model" />
@section Styles {
    <link rel="stylesheet" href="~/css/owner-listings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listing-editor.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/listing-upload-queue.js" asp-append-version="true" defer></script>
    <script src="~/js/listing-image-ordering.js" asp-append-version="true" defer></script>
    <script src="~/js/listing-editor.js" asp-append-version="true" defer></script>
}

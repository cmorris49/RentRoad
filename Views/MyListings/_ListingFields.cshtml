@model ListingFormViewModel
@{
    var priceInvalid = ViewData.ModelState.GetFieldValidationState(nameof(Model.DailyPriceCad)) == ModelValidationState.Invalid
        || ViewData.ModelState.GetFieldValidationState(nameof(Model.DailyPriceCents)) == ModelValidationState.Invalid;
}
<input asp-for="Latitude" type="hidden" />
<input asp-for="Longitude" type="hidden" />
<div class="owner-form-fields">
    <div class="owner-field-wide">
        <label asp-for="Title" class="form-label">@Text["ListingEditor.Title"]</label>
        <input asp-for="Title" class="form-control" maxlength="150" placeholder="@Text["ListingEditor.TitlePlaceholder"]" aria-describedby="title-error" />
        <span asp-validation-for="Title" id="title-error"></span>
    </div>
    <div class="owner-field-wide">
        <label asp-for="Description" class="form-label">@Text["ListingEditor.Description"]</label>
        <textarea asp-for="Description" class="form-control" rows="6" maxlength="2000" placeholder="@Text["ListingEditor.DescriptionPlaceholder"]" aria-describedby="description-error"></textarea>
        <span asp-validation-for="Description" id="description-error"></span>
    </div>
    <div>
        <label asp-for="Category" class="form-label">@Text["Browse.Category"]</label>
        <select asp-for="Category" class="form-select" aria-describedby="category-error">
            <option value="">@Text["ListingEditor.ChooseLater"]</option>
            @foreach (var category in Enum.GetValues<ListingCategory>())
            {
                <option value="@category">@ListingDisplayText.Category(category)</option>
            }
        </select>
        <span asp-validation-for="Category" id="category-error"></span>
    </div>
    <div>
        <label asp-for="Condition" class="form-label">@Text["Browse.Condition"]</label>
        <select asp-for="Condition" class="form-select" aria-describedby="condition-error">
            <option value="">@Text["ListingEditor.ChooseLater"]</option>
            @foreach (var condition in Enum.GetValues<ItemCondition>())
            {
                <option value="@condition">@ListingDisplayText.Condition(condition)</option>
            }
        </select>
        <span asp-validation-for="Condition" id="condition-error"></span>
    </div>
    <div>
        <label asp-for="DailyPriceCad" class="form-label">@Text["Browse.DailyPrice"]</label>
        <div class="input-group">
            <span class="input-group-text" aria-hidden="true">@Text["Currency.CadLabel"]</span>
            <input asp-for="DailyPriceCad" asp-format="{0:0.00}" type="number" step="0.01" min="0" inputmode="decimal" class="form-control @(priceInvalid ? "input-validation-error" : null)" placeholder="0.00" aria-invalid="@(priceInvalid ? "true" : null)" aria-describedby="price-errors" />
        </div>
        <div id="price-errors">
            <span asp-validation-for="DailyPriceCad"></span>
            <span asp-validation-for="DailyPriceCents"></span>
        </div>
    </div>
    <div>
        <label asp-for="PickupArea" class="form-label">@Text["Browse.PickupArea"]</label>
        <input asp-for="PickupArea" class="form-control" maxlength="150" placeholder="@Text["ListingEditor.PickupPlaceholder"]" aria-describedby="pickup-help pickup-error" />
        <div id="pickup-help" class="form-text">@Text["ListingEditor.PickupHelp"]</div>
        <span asp-validation-for="PickupArea" id="pickup-error"></span>
    </div>
</div>

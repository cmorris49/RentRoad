@model OwnerListingManagementViewModel
@{
    ViewData["Title"] = Text["Navigation.MyListings"].Value;
}
<div class="owner-page">
    <header class="page-header owner-page-heading">
        <div>
            <p class="eyebrow">@Text["MyListings.Eyebrow"]</p>
            <h1>@Text["Navigation.MyListings"]</h1>
            <p>@Text["MyListings.Introduction"]</p>
        </div>
        <a class="btn btn-primary" asp-action="Create">@Text["MyListings.CreateListing"] <span aria-hidden="true">+</span></a>
    </header>
    <partial name="_ListingFeedback" />
    @if (Model.Listings.Count == 0)
    {
        <section class="empty-state" aria-labelledby="empty-listings-heading">
            <p class="eyebrow">@Text["MyListings.EmptyEyebrow"]</p>
            <h2 id="empty-listings-heading">@Text["MyListings.EmptyState"]</h2>
            <p>@Text["MyListings.EmptyHelp"]</p>
            <a class="btn btn-primary" asp-action="Create">@Text["MyListings.CreateFirst"]</a>
        </section>
    }
    else
    {
        <section aria-labelledby="owner-listings-heading">
            <div class="owner-section-heading">
                <h2 id="owner-listings-heading" class="h4">@Text["MyListings.YourListings"] <span class="owner-listing-count">@Text["Common.CountInParentheses", Model.Listings.Count]</span></h2>
                <p class="text-muted">@Text["MyListings.IncludeDrafts"]</p>
            </div>
            <div class="owner-listings">
                @foreach (var listing in Model.Listings)
                {
                    var title = string.IsNullOrWhiteSpace(listing.Title) ? Text["MyListings.Untitled"].Value : listing.Title;
                    <article class="card owner-listing" aria-labelledby="listing-title-@listing.ListingId">
                        <div class="listing-card-media owner-listing-media">
                            <div class="listing-image-fallback" aria-hidden="@(listing.CoverImage is not null ? "true" : null)" data-image-fallback>
                                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="3" y="3" width="26" height="26" rx="4" /><circle cx="11" cy="11" r="3" /><path d="m4 25 8-8 5 5 5-7 7 10" /></svg>
                                <span>@(listing.CoverImage is null ? Text["ListingImages.NoPhotoYet"].Value : Text["Gallery.Unavailable"].Value)</span>
                            </div>
                            @if (listing.CoverImage is not null)
                            {
                                <img class="listing-card-image" data-listing-image src="@Url.Action("Get", "ListingImageContent", new { listingId = listing.ListingId, imageId = listing.CoverImage.ListingImageId })" alt="@(string.IsNullOrWhiteSpace(listing.CoverImage.AltText) ? title : listing.CoverImage.AltText)" loading="lazy" decoding="async" width="640" height="480" />
                            }
                        </div>
                        <div class="owner-listing-content">
                            <div class="owner-listing-title-row">
                                <h3 id="listing-title-@listing.ListingId" class="h5">@title</h3>
                                <partial name="_ListingStatus" model="listing.Status" />
                            </div>
                            <p class="owner-listing-price">
                                @(listing.DailyPrice?.FormattedAmount ?? Text["MyListings.NoPrice"].Value)
                                @if (listing.DailyPrice is not null)
                                {
                                    <span>@Text["Listing.PerDay"]</span>
                                }
                            </p>
                            <p class="listing-card-meta">@(string.IsNullOrWhiteSpace(listing.PickupArea) ? Text["MyListings.NoPickupArea"].Value : listing.PickupArea)</p>
                            <div class="owner-listing-actions">
                                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@listing.ListingId">@(listing.CanEdit ? Text["MyListings.EditListing"].Value : Text["MyListings.ViewArchived"].Value)<span class="visually-hidden">@Text["Common.ItemReference", title]</span></a>
                                <a class="btn btn-outline-primary" asp-controller="MyListings" asp-action="Edit" asp-route-id="@listing.ListingId" asp-fragment="editor-photos">@(listing.CanEdit ? Text["ListingImages.Manage"].Value : Text["ListingImages.View"].Value)<span class="visually-hidden">@Text["Common.ItemReference", title]</span></a>
                                <a class="btn btn-outline-primary" asp-controller="MyListings" asp-action="Edit" asp-route-id="@listing.ListingId" asp-fragment="editor-availability">@(listing.CanEdit ? Text["Availability.Manage"].Value : Text["Availability.View"].Value)<span class="visually-hidden">@Text["Common.ItemReference", title]</span></a>
                                @if (listing.Status is ListingStatus.Draft or ListingStatus.Unavailable)
                                {
                                    <form asp-action="Publish" asp-route-id="@listing.ListingId" method="post">
                                        <button class="btn btn-primary" type="submit">@Text["MyListings.ReviewListing"]<span class="visually-hidden">@Text["Common.ItemReference", title]</span></button>
                                    </form>
                                }
                                @if (listing.Status == ListingStatus.Published)
                                {
                                    <a class="btn btn-link" asp-controller="Listings" asp-action="Details" asp-route-id="@listing.ListingId">@Text["MyListings.ViewPublic"]<span class="visually-hidden">@Text["Common.ItemReference", title]</span></a>
                                }
                            </div>
                            @if (listing.CanEdit)
                            {
                                <partial name="_ArchiveListing" model="listing.ListingId" />
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>
@section Scripts {
    <script src="~/js/listing-images.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/owner-listings.css" asp-append-version="true" />
}

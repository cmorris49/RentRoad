@model OwnerListingManagementViewModel
@{
    ViewData["Title"] = "My Listings";
}
<div class="owner-page">
    <header class="page-header owner-page-heading">
        <div>
            <p class="eyebrow">Your corner of RentRoad</p>
            <h1>My Listings</h1>
            <p>Keep your items up to date, finish a draft, or revisit your listing history.</p>
        </div>
        <a class="btn btn-primary" asp-action="Create">Create listing <span aria-hidden="true">+</span></a>
    </header>
    <partial name="_ListingFeedback" />
    @if (Model.Listings.Count == 0)
    {
        <section class="empty-state" aria-labelledby="empty-listings-heading">
            <p class="eyebrow">Start with something you already own</p>
            <h2 id="empty-listings-heading">Your first listing starts here.</h2>
            <p>A useful tool, a camera, or gear for a weekend away. Save a draft now and add the finishing touches later.</p>
            <a class="btn btn-primary" asp-action="Create">Create your first listing</a>
        </section>
    }
    else
    {
        <section aria-labelledby="owner-listings-heading">
            <div class="owner-section-heading">
                <h2 id="owner-listings-heading" class="h4">Your listings <span class="owner-listing-count">(@Model.Listings.Count)</span></h2>
                <p class="text-muted">Drafts and archived items are included.</p>
            </div>
            <div class="owner-listings">
                @foreach (var listing in Model.Listings)
                {
                    var title = string.IsNullOrWhiteSpace(listing.Title) ? "Untitled listing" : listing.Title;
                    <article class="card owner-listing" aria-labelledby="listing-title-@listing.ListingId">
                        <div class="listing-card-media owner-listing-media">
                            <div class="listing-image-fallback" aria-hidden="@(listing.CoverImage is not null ? "true" : null)" data-image-fallback>
                                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="3" y="3" width="26" height="26" rx="4" /><circle cx="11" cy="11" r="3" /><path d="m4 25 8-8 5 5 5-7 7 10" /></svg>
                                <span>@(listing.CoverImage is null ? "No photo yet" : "Photo unavailable")</span>
                            </div>
                            @if (listing.CoverImage is not null)
                            {
                                <img class="listing-card-image" data-listing-image src="@Url.Action("Get", "ListingImageContent", new { listingId = listing.ListingId, imageId = listing.CoverImage.ListingImageId })" alt="@(string.IsNullOrWhiteSpace(listing.CoverImage.AltText) ? title : listing.CoverImage.AltText)" loading="lazy" decoding="async" width="640" height="480" />
                            }
                        </div>
                        <div class="owner-listing-content">
                            <div class="owner-listing-title-row">
                                <h3 id="listing-title-@listing.ListingId" class="h5">@title</h3>
                                <partial name="_ListingStatus" model="listing.Status" />
                            </div>
                            <p class="owner-listing-price">@(listing.DailyPrice?.FormattedAmount ?? "Price not set") @if (listing.DailyPrice is not null) { <span>/ day</span> }</p>
                            <p class="listing-card-meta">@(string.IsNullOrWhiteSpace(listing.PickupArea) ? "Pickup area not set" : listing.PickupArea)</p>
                            <div class="owner-listing-actions">
                                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@listing.ListingId">@(listing.CanEdit ? "Edit listing" : "View archived listing")<span class="visually-hidden">: @title</span></a>
                                <a class="btn btn-outline-primary" asp-controller="MyListings" asp-action="Edit" asp-route-id="@listing.ListingId" asp-fragment="editor-photos">@(listing.CanEdit ? "Manage images" : "View images")<span class="visually-hidden">: @title</span></a>
                                <a class="btn btn-outline-primary" asp-controller="MyListings" asp-action="Edit" asp-route-id="@listing.ListingId" asp-fragment="editor-availability">@(listing.CanEdit ? "Manage availability" : "View availability")<span class="visually-hidden">: @title</span></a>
                                @if (listing.Status is ListingStatus.Draft or ListingStatus.Unavailable)
                                {
                                    <form asp-action="Publish" asp-route-id="@listing.ListingId" method="post">
                                        <button class="btn btn-primary" type="submit">Review listing<span class="visually-hidden">: @title</span></button>
                                    </form>
                                }
                                @if (listing.Status == ListingStatus.Published)
                                {
                                    <a class="btn btn-link" asp-controller="Listings" asp-action="Details" asp-route-id="@listing.ListingId">View public listing<span class="visually-hidden">: @title</span></a>
                                }
                            </div>
                            @if (listing.CanEdit)
                            {
                                <partial name="_ArchiveListing" model="listing.ListingId" />
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>
@section Scripts {
    <script src="~/js/listing-images.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/owner-listings.css" asp-append-version="true" />
}

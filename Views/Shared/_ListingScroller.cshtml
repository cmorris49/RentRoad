@using RentRoad.ViewModels.Listings
@model ListingScrollerViewModel
@if (Model.Listings.Count > 0 || Model.ShowBrowseLink)
{
    <section class="listing-scroller page-section" aria-labelledby="@(Model.Id)-heading" data-listing-scroller>
        <div class="listing-scroller-heading">
            <h2 id="@(Model.Id)-heading">@Model.Heading</h2>
            <div class="listing-scroller-actions">
                @if (Model.ShowBrowseLink)
                {
                    <a asp-controller="Listings" asp-action="Index">@Text["Listing.BrowseAll"] <span aria-hidden="true">→</span></a>
                }
                @if (Model.Listings.Count > 0)
                {
                    <div class="listing-scroller-controls" data-scroller-controls hidden>
                        <button class="btn btn-outline-primary" type="button" data-scroller-previous aria-label="@Text["Listing.PreviousInSection", Model.Heading]" aria-controls="@(Model.Id)-track" disabled><span aria-hidden="true">←</span></button>
                        <button class="btn btn-outline-primary" type="button" data-scroller-next aria-label="@Text["Listing.NextInSection", Model.Heading]" aria-controls="@(Model.Id)-track" disabled><span aria-hidden="true">→</span></button>
                    </div>
                }
            </div>
        </div>
        @if (Model.Listings.Count == 0)
        {
            <p class="text-muted">@Text["Listing.NonePublished"]</p>
        }
        else
        {
            <p class="visually-hidden" id="@(Model.Id)-help">@Text["Listing.ScrollInstructions"]</p>
            <ul id="@(Model.Id)-track" class="listing-scroller-track" role="list" data-scroller-track tabindex="0" aria-labelledby="@(Model.Id)-heading" aria-describedby="@(Model.Id)-help">
                @foreach (var listing in Model.Listings)
                {
                    <li class="listing-scroller-item"><partial name="~/Views/Listings/_ListingCard.cshtml" model="listing" /></li>
                }
            </ul>
        }
    </section>
}

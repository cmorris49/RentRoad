@model RentRoad.ViewModels.Account.AccountNavigationViewModel

<ul class="navbar-nav account-navigation">
    @if (Model.IsSignedIn)
    {
        <li class="nav-item messages-navigation-item">
            <a class="btn messages-navigation-link" asp-area="" asp-controller="Messages" asp-action="Index" data-messages-navigation aria-label="@Text["Conversations.Navigation"]" title="@Text["Conversations.Navigation"]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
                    <rect x="3" y="5" width="18" height="14" rx="3" />
                    <path d="m4 7 8 6 8-6" stroke-linejoin="round" />
                </svg>
                <span class="messages-navigation-text">@Text["Conversations.Navigation"]</span>
                <span class="messages-navigation-unread" data-navigation-unread role="img" hidden></span>
            </a>
        </li>
        <li class="nav-item dropdown account-desktop">
            <button class="btn btn-outline-primary dropdown-toggle account-toggle" type="button" id="account-menu" data-bs-toggle="dropdown" aria-expanded="false" title="@Model.DisplayName">
                <span class="account-display-name">@Model.DisplayName</span>
                <svg class="account-profile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></svg>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="account-menu">
                <li><a class="dropdown-item" asp-area="" asp-controller="Rentals" asp-action="Mine">@Text["RentalManagement.Mine"]</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="Rentals" asp-action="Incoming">@Text["RentalManagement.Incoming"]</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="Settings" asp-action="Index">@Text["Navigation.Settings"]</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item">@Text["Navigation.LogOut"]</button>
                    </form>
                </li>
            </ul>
        </li>
        <li class="account-mobile"><a class="nav-link" asp-area="" asp-controller="Rentals" asp-action="Mine">@Text["RentalManagement.Mine"]</a></li>
        <li class="account-mobile"><a class="nav-link" asp-area="" asp-controller="Rentals" asp-action="Incoming">@Text["RentalManagement.Incoming"]</a></li>
        <li class="account-mobile account-mobile-divider"><a class="nav-link" asp-area="" asp-controller="Settings" asp-action="Index">@Text["Navigation.Settings"]</a></li>
        <li class="account-mobile account-mobile-divider">
            <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link">@Text["Navigation.LogOut"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">@Text["Navigation.LogIn"]</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">@Text["Navigation.Register"]</a>
        </li>
    }
</ul>

@if (Model.IsSignedIn)
{
    <script type="application/json" id="messages-navigation-config">@Json.Serialize(new { realtime = new RentRoad.ViewModels.Messaging.MessagingConnectionViewModel(Url.Content("~/hubs/messages")), unreadCountUrl = Url.Action("UnreadCount", "Messages") })</script>
}

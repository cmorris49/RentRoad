@model ErrorViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> HtmlText
@{
    ViewData["Title"] = Text["Error.Title"];
}

<h1 class="text-danger">@Text["Error.Heading"]</h1>
<h2 class="text-danger">@Text["Error.Description"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Text["Error.RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Text["Error.DevelopmentHeading"]</h3>
<p>@HtmlText["Error.DevelopmentDetails"]</p>
<p>@HtmlText["Error.DevelopmentWarning"]</p>

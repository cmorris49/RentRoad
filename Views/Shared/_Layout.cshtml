@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    var isMessaging = ViewData["MessagingLayout"] is true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isHome = controller == "Home" && action == "Index";
    var isBrowsing = controller == "Listings";
    var isCreating = controller == "MyListings" && action == "Create";
    var isManaging = (controller == "MyListings" && !isCreating)
        || controller is "ListingImages" or "ListingAvailability";
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="@(isMessaging ? "width=device-width, initial-scale=1.0, interactive-widget=resizes-content" : "width=device-width, initial-scale=1.0")" />
    <meta name="color-scheme" content="light dark" />
    <title>@Text["Application.PageTitle", ViewData["Title"] ?? string.Empty]</title>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RentRoad.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listing-gallery.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="site-shell @(isMessaging ? "site-shell--messaging" : null)">
    <a class="skip-link" href="#main-content">@Text["Navigation.SkipToContent"]</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-xl" aria-label="@Text["Navigation.Main"]">
            <div class="container site-nav-container">
                <a class="navbar-brand brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="@Text["Navigation.BrandHome"]">
                    <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                        <rect class="brand-mark-background" width="40" height="40" rx="13" />
                        <path d="M12 29 17 11h6l5 18M20 14v4m0 5v4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <partial name="_BrandWordmark" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation"
                        aria-controls="main-navigation" aria-expanded="false" aria-label="@Text["Navigation.Toggle"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav primary-navigation">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : null)" aria-current="@(isHome ? "page" : null)" asp-area="" asp-controller="Home" asp-action="Index">@Text["Navigation.Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isBrowsing ? "active" : null)" aria-current="@(isBrowsing ? "page" : null)" asp-area="" asp-controller="Listings" asp-action="Index">@Text["Navigation.BrowseListings"]</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isManaging ? "active" : null)" aria-current="@(isManaging ? "page" : null)" asp-area="" asp-controller="MyListings" asp-action="Index">@Text["Navigation.MyListings"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isCreating ? "active" : null)" aria-current="@(isCreating ? "page" : null)" asp-area="" asp-controller="MyListings" asp-action="Create">@Text["Navigation.CreateListing"]</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="container site-main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <div>
                <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index"><partial name="_BrandWordmark" /></a>
                <p class="footer-tagline">@Text["Brand.Tagline"]</p>
            </div>
            <div class="footer-meta">
                <span>@Text["Footer.Location"]</span>
                <span>@Text["Footer.Copyright", DateTime.UtcNow.Year] <span class="footer-separator" aria-hidden="true">/</span> <a asp-area="" asp-controller="Home" asp-action="Privacy">@Text["Navigation.Privacy"]</a></span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ClientStrings" />
    <script src="~/js/localized-ui.js" asp-append-version="true"></script>
    <script src="~/js/listing-gallery.js" asp-append-version="true" defer></script>
    @if (SignInManager.IsSignedIn(User))
    {
        <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js" asp-append-version="true" defer></script>
        <script src="~/js/messaging-realtime.js" asp-append-version="true" defer></script>
        <script src="~/js/messaging-unread.js" asp-append-version="true" defer></script>
    }
    <script src="~/js/site-navigation.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

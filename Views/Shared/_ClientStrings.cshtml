@{
    var client = ViewData["ClientResources"] as string;
    var shared = client == "rental" ? new[] { "Currency.CadAmount", "RentalRequest.DurationOne", "RentalRequest.DurationMany", "RentalRequest.InvalidPrice", "RentalRequest.PriceOverflow", "RentalRequest.FutureStartRequired", "Availability.LastDayBeforeFirst" }
        : client == "editor" ? new[] { "MyListings.Untitled", "MyListings.NoPickupArea", "MyListings.NoPrice", "ListingDetails.OwnerFallback", "Common.SaveChanges", "Common.Remove", "Currency.CadAmount" }
        : client == "images" ? new[] { "ListingImages.LocalPreviewOnlyChooseUploadImageToSaveIt", "ListingImages.PreviewUnavailable",
            "ListingImages.Uploading", "ListingImages.UploadingYourImagePleaseWait", "ListingImages.UploadImage" } : Array.Empty<string>();
    var strings = Text.GetAllStrings(includeParentCultures: true)
        .Where(value => value.Name.StartsWith("Gallery.", StringComparison.Ordinal) || shared.Contains(value.Name)
            || User.Identity?.IsAuthenticated == true && new[] { "Conversations.UnreadCount", "Conversations.UnreadCountOne", "Conversations.UnreadUnavailable" }.Contains(value.Name)
            || client == "messaging" && (value.Name.StartsWith("Messages.", StringComparison.Ordinal) || value.Name.StartsWith("Conversations.", StringComparison.Ordinal))
            || client == "rental" && value.Name.StartsWith("RentalRequestUi.", StringComparison.Ordinal)
            || client == "editor" && new[] { "ListingEditor.", "UploadQueue.", "ListingStatus." }
                .Any(prefix => value.Name.StartsWith(prefix, StringComparison.Ordinal)))
        .ToDictionary(value => value.Name, value => value.Value);
}
<script type="application/json" id="rentroad-ui-strings">@Json.Serialize(strings)</script>

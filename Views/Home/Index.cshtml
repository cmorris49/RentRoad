@using Microsoft.AspNetCore.Identity
@using RentRoad.Models.Enums
@using RentRoad.Services.Listings
@using RentRoad.ViewModels.Listings
@inject SignInManager<ApplicationUser> SignInManager
@model HomeViewModel
@{
    ViewData["Title"] = Text["Home.PageTitle"];
}

<div class="home-page">
<section class="home-hero page-section" aria-labelledby="home-heading">
    <div class="hero-copy">
        <p class="eyebrow">@Text["Brand.Tagline"]</p>
        <h1 id="home-heading"><partial name="_BrandWordmark" /></h1>
        <p class="hero-introduction">@Text["Home.Introduction"]</p>
        <form class="hero-search" method="get" asp-controller="Listings" asp-action="Index" role="search" aria-label="@Text["Home.SearchLabel"]">
            <label asp-for="SearchText" class="form-label">@Text["Home.SearchPrompt"]</label>
            <div class="hero-search-controls">
                <input asp-for="SearchText" type="search" class="form-control" placeholder="@Text["Home.SearchPlaceholder"]" maxlength="@ListingSearchParameters.MAX_SEARCH_TEXT_LENGTH" />
                <button type="submit" class="btn btn-primary">@Text["Home.FindRentals"] <span aria-hidden="true">↗</span></button>
            </div>
        </form>
        <div class="hero-actions">
            <a class="hero-browse-link" asp-controller="Listings" asp-action="Index"><span>@Text["Home.BrowseRentals"]</span><span aria-hidden="true">→</span></a>
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="btn btn-outline-primary" asp-controller="MyListings" asp-action="Create">@Text["Navigation.CreateListing"]</a>
            }
        </div>
    </div>
    <partial name="_HeroListingShowcase" model="Model.PopularListings" />
</section>

<section class="home-categories page-section" aria-labelledby="categories-heading">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@Text["Home.CategoriesEyebrow"]</p>
            <h2 id="categories-heading">@Text["Home.CategoriesHeading"]</h2>
        </div>
    </div>
    <nav class="category-grid" aria-label="@Text["Home.CategoriesLabel"]">
        @foreach (var category in Enum.GetValues<ListingCategory>())
        {
            <a class="category-link" asp-controller="Listings" asp-action="Index" asp-route-Category="@category">
                <svg class="category-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                    <use href="@Url.Content($"~/images/listing-categories.svg#{category}")" />
                </svg>
                <span>@ListingDisplayText.Category(category)</span>
                <span class="category-arrow" aria-hidden="true">↗</span>
            </a>
        }
    </nav>
</section>

<partial name="_ListingScroller" model='@(new ListingScrollerViewModel("popular-listings", Text["Home.PopularListings"].Value, Model.PopularListings, true))' />

<section class="marketplace-introduction page-section" aria-labelledby="sharing-heading">
    <div>
        <p class="eyebrow">@Text["Home.SharingEyebrow"]</p>
        <h2 id="sharing-heading">@Text["Home.SharingHeading"]</h2>
    </div>
    <p>@Text["Home.SharingIntroduction"]</p>
</section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/listing-scroller.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hero-listing-showcase.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/listing-scroller.js" asp-append-version="true" defer></script>
    <script src="~/js/hero-listing-showcase.js" asp-append-version="true" defer></script>
}

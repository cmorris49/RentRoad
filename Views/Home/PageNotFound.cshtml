@{
    ViewData["Title"] = Text["NotFound.Title"];
}
<section class="not-found-page" aria-labelledby="not-found-heading">
    <p class="eyebrow">@Text["Common.BrandName"]</p>
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 id="not-found-heading"><span class="visually-hidden">404 — </span>@Text["NotFound.Title"]</h1>
    <p>@Text["NotFound.Description"]</p>
    <div class="not-found-actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index" asp-area="">@Text["NotFound.GoHome"]</a>
        <a class="btn btn-outline-primary" asp-controller="Listings" asp-action="Index" asp-area="">@Text["Navigation.BrowseListings"]</a>
    </div>
</section>

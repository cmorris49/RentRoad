@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.LoginModel
@{
    ViewData["Title"] = Text["Identity.LoginHeading"];
}
<h1>@ViewData["Title"]</h1>
<div class="row g-4">
    <section class="col-md-6">
        <form id="account" method="post">
            <h2 class="h4">@Text["Identity.LocalLogin"]</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <label asp-for="Input.Email">@Text["Identity.Email"]</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                <label asp-for="Input.Password">@Text["Identity.Password"]</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <label class="form-check-label mb-3"><input asp-for="Input.RememberMe" class="form-check-input" /> @Text["Identity.RememberMe"]</label>
            <button id="login-submit" type="submit" class="w-100 btn btn-primary">@Text["Identity.LoginButton"]</button>
            <p class="mt-3"><a id="forgot-password" asp-page="./ForgotPassword">@Text["Identity.ForgotPassword"]</a></p>
            <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">@Text["Identity.RegisterLink"]</a></p>
            <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation">@Text["Identity.ResendConfirmation"]</a></p>
        </form>
    </section>
    <section class="col-md-6">
        <h2 class="h4">@Text["Identity.OtherLogin"]</h2>
        @if (Model.ExternalLogins?.Count > 0)
        {
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins)
                {
                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name">@provider.DisplayName</button>
                }
            </form>
        }
        else
        {
            <p>@Text["Identity.ExternalNotConfigured"]</p>
        }
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
